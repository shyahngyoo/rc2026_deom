<?xml version="1.0" encoding="UTF-8"?>

<root main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">

    <Sequence name="PrecisionApproach">

      <!-- Plan the approach path -->
      <RecoveryNode
          name="ApproachPlannerRecovery"
          number_of_retries="1">

        <ComputePathToPose
            goal="{goal}"
            path="{path}"
            planner_id="GridBasedApproach"/>

        <ClearEntireCostmap
            name="ClearGlobalAfterPlanFailure"
            service_name="global_costmap/clear_entirely_global_costmap"/>

      </RecoveryNode>

      <!-- Follow the approach path -->
      <RecoveryNode
          name="ApproachControllerRecovery"
          number_of_retries="1">

        <FollowPath
            path="{path}"
            controller_id="FollowPathApproach"
            goal_checker_id="approach_goal_checker"/>

        <ClearEntireCostmap
            name="ClearLocalAfterControlFailure"
            service_name="local_costmap/clear_entirely_local_costmap"/>

      </RecoveryNode>

    </Sequence>

  </BehaviorTree>

</root>